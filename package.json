{
  "name": "@local/dsh-enter-send-swap",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Heydo",
  "type": "module",
  "description": "Shift+Enter sends the message and Enter inserts a line break in the DSH Web composer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
